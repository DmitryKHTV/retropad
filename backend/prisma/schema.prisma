generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  columns Column[]
  members BoardMember[]
  votes   Vote[]

  @@index([ownerId])
}

// OWNER is never stored here — it is synthesized from Board.ownerId (single source of truth)
enum BoardRole {
  EDITOR
  VIEWER
}

model BoardMember {
  boardId   String
  userId    String
  role      BoardRole @default(EDITOR)
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model Column {
  id        String   @id @default(uuid())
  title     String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  stickers Sticker[]

  @@index([boardId])
}

model Sticker {
  id        String   @id @default(uuid())
  content   String
  color     String   @default("yellow")
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  votes Vote[]

  @@index([columnId])
  @@index([authorId])
}

model Vote {
  stickerId String
  userId    String
  boardId   String
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sticker Sticker @relation(fields: [stickerId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([stickerId, userId])
  // boardId leads: serves both `WHERE boardId` (per-sticker totals) and
  // `WHERE boardId AND userId` (vote-limit check). userId needs its own index —
  // the composite can't serve the FK cascade, it isn't the leftmost column.
  @@index([boardId, userId])
  @@index([userId])
}

// Demo accounts: a GUEST is created by POST /auth/demo and lives for a day;
// DEMO_TEAMMATE accounts are seeded by a migration and only ever appear as
// members of guest boards. Neither can log in or be added by email.
// User.expiresAt is set only for a GUEST.
enum UserKind {
  REGULAR
  GUEST
  DEMO_TEAMMATE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  kind         UserKind  @default(REGULAR)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  boards        Board[]
  memberships   BoardMember[]
  refreshTokens RefreshToken[]
  stickers      Sticker[]
  votes         Vote[]

  @@index([kind, expiresAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?

  @@index([userId])
  @@index([expiresAt])
}
