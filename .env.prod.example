# Production compose config. Copy to `.env` ON THE SERVER and fill in real
# values: `docker compose -f docker-compose.prod.yml` reads this file automatically.
# Never commit the filled-in version.

POSTGRES_USER=retropad
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=retropad

# JWT secrets: at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_at_least_32_characters_long_random_string
JWT_EXPIRES_IN=15min
JWT_REFRESH_SECRET=change_me_another_32_characters_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Origins the browser may call the API from (HTTP CORS + socket.io handshake).
CORS_ORIGIN=https://retropad.dkhomutov.dev

# Public API origin, baked into the frontend bundle at BUILD time.
# Changing it requires a rebuild of the frontend image, not just a restart.
NEXT_PUBLIC_API_URL=https://api-retropad.dkhomutov.dev
